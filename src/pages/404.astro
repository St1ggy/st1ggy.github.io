---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Страница не найдена — St1ggy" description="Такой страницы не существует.">
  <main>
    <span>Ошибка 404</span>
    <h1>Этой двери<br />не существует.</h1>
    <a href="/">Вернуться в реальность →</a>
  </main>
</BaseLayout>

<style lang="scss">
  main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: min(100% - 2rem, 1500px);
    min-height: 100vh;
    margin: auto;
  }

  span,
  a {
    font-family: "Unbounded", sans-serif;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  span {
    color: var(--accent);
  }

  h1 {
    margin: 2rem 0 4rem;
    font-family: "Unbounded", sans-serif;
    font-size: clamp(3.2rem, 9vw, 8rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.07em;
  }

  a {
    width: fit-content;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.5rem;
  }
</style>
