---
import WorldPortal from "../components/WorldPortal.astro";
import { worlds } from "../data/projects";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "St1ggy Atlas — миры и игровые системы";
const description = "Атлас авторских миров, игровых модулей и связанных справочников.";
---

<BaseLayout {title} {description}>
  <main>
    <header class="masthead">
      <a href="/" class="identity"><span>S1</span><strong>ST1GGY ATLAS</strong></a>
      <p>Каталог вымышленных систем и миров</p>
      <div><span>INDEX / {String(worlds.length).padStart(3, "0")}</span><span>RU · PUBLIC</span></div>
    </header>

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__coordinates" aria-hidden="true"><span>55.75° N</span><i></i><span>37.61° E</span></div>
      <div>
        <p class="kicker">Полевой архив · Редакция {new Date().getFullYear()}</p>
        <h1 id="hero-title">Атлас<br /><em>открытых</em><br />миров</h1>
      </div>
      <aside>
        <p>Каждый проект здесь — не промо-карточка, а самостоятельный вход: со своим языком, ритмом и системой навигации.</p>
        <a href="#worlds">Выбрать координату <span>↓</span></a>
      </aside>
    </section>

    <section class="legend" aria-label="Легенда атласа">
      <span><i class="legend__live"></i> Опубликовано</span>
      <span><i class="legend__rules"></i> Игровые правила</span>
      <span><i class="legend__world"></i> Энциклопедия мира</span>
      <p>Два мира · одна точка входа</p>
    </section>

    <section class="worlds" id="worlds" aria-labelledby="worlds-title">
      <header class="section-heading"><div><p>Координаты</p><h2 id="worlds-title">Выбери порог</h2></div><span>01—{String(worlds.length).padStart(2, "0")}</span></header>
      <div class="world-grid">{worlds.map((world, index) => <WorldPortal {world} {index} />)}</div>
    </section>

    <section class="principles">
      <header><p>Устройство атласа</p><h2>Не портфолио.<br />Рабочие миры.</h2></header>
      <ol>
        <li><span>01</span><div><strong>Связная структура</strong><p>Материалы собраны в маршруты, а не в свалку отдельных страниц.</p></div></li>
        <li><span>02</span><div><strong>Готовность к игре</strong><p>Правила, персонажи и инструменты доступны прямо за столом.</p></div></li>
        <li><span>03</span><div><strong>Живые редакции</strong><p>Миры развиваются, но опубликованные пути остаются стабильными.</p></div></li>
      </ol>
    </section>

    <footer>
      <div><strong>ST1GGY / ATLAS</strong><p>Миры, истории и игровые системы.</p></div>
      <p>© {new Date().getFullYear()} · Создано между правилами и воображением.</p>
      <a href="https://github.com/St1ggy">GitHub ↗</a>
    </footer>
  </main>
</BaseLayout>

<style lang="scss">
  main { width: min(100% - 2rem, 1500px); margin: 0 auto; }
  .masthead { display: grid; grid-template-columns: 1fr auto 1fr; gap: 2rem; align-items: center; min-height: 6rem; border-bottom: 1px solid var(--ink); }
  .identity { display: flex; gap: 0.7rem; align-items: center; width: fit-content; text-decoration: none; }
  .identity span { display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border: 1px solid var(--ink); font-family: var(--mono); font-size: 0.65rem; }
  .identity strong { font-family: var(--display); font-size: 1.25rem; letter-spacing: 0.06em; }
  .masthead > p, .masthead > div { margin: 0; color: var(--muted); font-family: var(--mono); font-size: 0.58rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .masthead > div { display: flex; gap: 1rem; justify-self: end; }
  .hero { position: relative; display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(17rem, 0.5fr); gap: 3rem; align-items: end; min-height: clamp(34rem, 72vh, 50rem); padding: 5rem 0 4rem; }
  .hero__coordinates { position: absolute; top: 3rem; right: 0; display: flex; gap: 0.6rem; align-items: center; color: var(--muted); font-family: var(--mono); font-size: 0.54rem; }
  .hero__coordinates i { width: 7rem; height: 1px; background: var(--line); }
  .kicker, .section-heading p, .principles header p { margin: 0 0 1.2rem; color: var(--blue); font-family: var(--mono); font-size: 0.61rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  h1 { margin: 0; font-family: var(--display); font-size: clamp(5rem, 12vw, 12rem); font-weight: 650; line-height: 0.68; letter-spacing: -0.065em; text-transform: uppercase; }
  h1 em { color: var(--orange); font-style: normal; }
  .hero aside { align-self: end; padding: 1.2rem 0 0 1.2rem; border-top: 1px solid var(--ink); border-left: 0.35rem solid var(--orange); }
  .hero aside p { margin: 0; color: var(--muted); line-height: 1.65; }
  .hero aside a { display: flex; justify-content: space-between; margin-top: 2rem; padding-top: 0.8rem; border-top: 1px solid var(--line); font-family: var(--mono); font-size: 0.62rem; font-weight: 700; text-decoration: none; text-transform: uppercase; }
  .legend { display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; padding: 0.8rem 0; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); font-family: var(--mono); font-size: 0.56rem; text-transform: uppercase; }
  .legend span { display: flex; gap: 0.45rem; align-items: center; }
  .legend i { display: block; width: 0.55rem; height: 0.55rem; border-radius: 50%; }
  .legend__live { background: #4d9e7c; } .legend__rules { background: var(--orange); } .legend__world { background: var(--blue); }
  .legend p { margin: 0 0 0 auto; color: var(--muted); }
  .worlds { padding: 8rem 0; scroll-margin-top: 1rem; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; margin-bottom: 1.5rem; }
  .section-heading p { margin-bottom: 0.4rem; }
  .section-heading h2, .principles h2 { margin: 0; font-family: var(--display); font-size: clamp(3rem, 7vw, 6.5rem); font-weight: 650; line-height: 0.8; letter-spacing: -0.04em; text-transform: uppercase; }
  .section-heading > span { font-family: var(--mono); font-size: 0.6rem; }
  .world-grid { display: grid; gap: 1.2rem; }
  .principles { display: grid; grid-template-columns: minmax(18rem, 0.75fr) minmax(0, 1.25fr); gap: clamp(3rem, 8vw, 8rem); padding: 7rem 0; border-top: 1px solid var(--ink); }
  .principles ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--ink); }
  .principles li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1.2rem 0; border-bottom: 1px solid var(--line); }
  .principles li > span { color: var(--orange); font-family: var(--mono); font-size: 0.6rem; }
  .principles strong { font-family: var(--display); font-size: 1.35rem; text-transform: uppercase; }
  .principles li p { margin: 0.25rem 0 0; color: var(--muted); font-size: 0.82rem; }
  footer { display: grid; grid-template-columns: 1fr 1fr auto; gap: 2rem; align-items: end; padding: 2.2rem 0; border-top: 1px solid var(--ink); font-family: var(--mono); font-size: 0.58rem; text-transform: uppercase; }
  footer strong { font-family: var(--display); font-size: 1.2rem; }
  footer p { margin: 0.3rem 0 0; color: var(--muted); }

  @media (max-width: 760px) {
    .masthead { grid-template-columns: 1fr auto; }
    .masthead > p { display: none; }
    .masthead > div span:first-child { display: none; }
    .hero { grid-template-columns: 1fr; align-content: end; min-height: 39rem; padding-top: 5rem; }
    .hero__coordinates { top: 1.5rem; }
    h1 { font-size: clamp(3.5rem, 18vw, 5.2rem); line-height: 0.72; }
    .legend p { width: 100%; margin: 0; }
    .worlds { padding: 5rem 0; }
    .principles { grid-template-columns: 1fr; padding: 5rem 0; }
    footer { grid-template-columns: 1fr; }
  }
</style>
