---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const number = String(index + 1).padStart(2, "0");
---

<a class="project" href={project.href} aria-label={`Открыть проект «${project.title}»`}>
  <span class="project__index" aria-hidden="true">{number}</span>
  <div class="project__content">
    <span class="project__eyebrow">{project.eyebrow}</span>
    <h2>{project.title}</h2>
    <p>{project.description}</p>
    <span class="project__meta">{project.meta}</span>
  </div>
  <span class="project__action">
    {project.status}
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 12h13M13 6l6 6-6 6"></path>
    </svg>
  </span>
  <span class="project__orb" aria-hidden="true"></span>
</a>

<style lang="scss">
  .project {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    gap: clamp(1.25rem, 3vw, 3.5rem);
    min-height: 25rem;
    overflow: hidden;
    padding: clamp(1.5rem, 4vw, 3.5rem);
    border: 1px solid var(--line);
    border-radius: 0.25rem;
    text-decoration: none;
    background: linear-gradient(130deg, rgba(18, 24, 25, 0.96), rgba(12, 15, 17, 0.72));
    transition: border-color 400ms ease, transform 400ms ease, background-color 400ms ease;
    isolation: isolate;
  }

  .project::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(110deg, transparent 25%, rgba(168, 201, 188, 0.08), transparent 70%);
    transform: translateX(-100%);
    transition: transform 800ms ease;
    content: "";
  }

  .project:hover,
  .project:focus-visible {
    border-color: rgba(168, 201, 188, 0.52);
    outline: none;
    transform: translateY(-4px);
  }

  .project:hover::before,
  .project:focus-visible::before {
    transform: translateX(100%);
  }

  .project__index,
  .project__eyebrow,
  .project__meta,
  .project__action {
    font-family: "Unbounded", sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .project__index {
    color: var(--muted);
    font-size: 0.68rem;
  }

  .project__content {
    align-self: center;
    max-width: 45rem;
  }

  .project__eyebrow {
    display: block;
    margin-bottom: 1.25rem;
    color: var(--accent);
    font-size: 0.68rem;
  }

  h2 {
    margin: 0 0 1.5rem;
    font-family: "Unbounded", sans-serif;
    font-size: clamp(3.25rem, 9vw, 7.5rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  p {
    max-width: 39rem;
    margin: 0 0 2rem;
    color: #b7bcba;
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.65;
  }

  .project__meta {
    color: var(--muted);
    font-size: 0.6rem;
  }

  .project__action {
    display: flex;
    align-items: flex-end;
    align-self: end;
    gap: 0.85rem;
    font-size: 0.65rem;
    white-space: nowrap;
  }

  svg {
    width: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    transition: transform 300ms ease;
  }

  .project:hover svg,
  .project:focus-visible svg {
    transform: translateX(0.3rem);
  }

  .project__orb {
    position: absolute;
    z-index: -2;
    top: 50%;
    right: 8%;
    width: clamp(13rem, 30vw, 24rem);
    aspect-ratio: 1;
    border: 1px solid rgba(168, 201, 188, 0.13);
    border-radius: 50%;
    background:
      radial-gradient(circle at 37% 34%, rgba(183, 219, 205, 0.22), transparent 5%),
      radial-gradient(circle at 50% 50%, rgba(56, 96, 82, 0.27), rgba(13, 18, 18, 0.07) 64%);
    box-shadow: inset -2rem -2rem 5rem rgba(0, 0, 0, 0.45), 0 0 5rem rgba(67, 106, 92, 0.1);
    opacity: 0.8;
    transform: translateY(-50%);
  }

  @media (max-width: 720px) {
    .project {
      grid-template-columns: 1fr;
      min-height: 32rem;
    }

    .project__content {
      align-self: end;
    }

    .project__action {
      align-self: auto;
    }

    .project__orb {
      top: 30%;
      right: -12%;
    }
  }
</style>
